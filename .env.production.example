# Production Django Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-for-production!
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
TIME_ZONE=Asia/Tashkent

# Production Database (PostgreSQL)
DB_ENGINE=postgres
DB_NAME=evently_production
DB_USER=evently_user
DB_PASSWORD=your_strong_postgres_password
DB_HOST=localhost
DB_PORT=5432

# JWT Tokens
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRstuVWxyz_your_real_bot_token
TELEGRAM_BOT_USERNAME=EventlyOfficialBot
BOT_API_SECRET=generate-a-strong-secret-key-shared-between-bot-and-backend
BACKEND_API_URL=https://api.yourdomain.com/api/v1

# Reminders
REMINDER_HOURS_BEFORE=24
