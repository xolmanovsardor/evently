# ==============================================================================
# Evently — Namunaviy Muhit Sozlamalari (.env.example)
# ==============================================================================
# Ushbu fayl shablon hisoblanadi. Undan foydalanish uchun nusxa olib,
# .env nomiga o'zgartiring va o'z parametrlaringizni kiriting:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Asosiy Sozlamalari
# ------------------------------------------------------------------------------
# Ishlab chiqish muhitida True, production uchun False
DEBUG=True

# Django maxfiy kaliti (kamida 50 ta tasodifiy belgidan iborat bo'lsin)
SECRET_KEY=your-django-super-secret-key-change-me-in-production-random-50-chars

# Ruxsat etilgan hostlar (vergul bilan ajratilgan)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Ishonchli CSRF originlar (portlar bilan birga)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Vaqt mintaqasi
TIME_ZONE=Asia/Tashkent

# ------------------------------------------------------------------------------
# 2. Ma'lumotlar Bazasi (Database)
# ------------------------------------------------------------------------------
# Lokal sinovlar uchun 'sqlite', haqiqiy PostgreSQL uchun 'postgres'
DB_ENGINE=sqlite

# PostgreSQL parametrlari (agar DB_ENGINE=postgres bo'lsa ishlatiladi)
DB_NAME=evently_db
DB_USER=postgres_user
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. SimpleJWT Autentifikatsiya Sozlamalari
# ------------------------------------------------------------------------------
# Access token muddati (daqiqa)
ACCESS_TOKEN_LIFETIME_MINUTES=60

# Refresh token muddati (kun)
REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------------------------------------------
# 4. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Frontend mijozlar (React, Vue, mobile) uchun ochiq domenlar
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 5. Telegram Bot Integratsiyasi
# ------------------------------------------------------------------------------
# @BotFather dan olingan bot tokeni
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_example_token

# Bot foydalanuvchi nomi (@ siz)
TELEGRAM_BOT_USERNAME=YourEventlyBot

# Backend va Bot o'rtasidagi xavfsiz ichki kalit (X-Bot-Secret sarlavhasi uchun)
BOT_API_SECRET=your-secure-internal-bot-secret-key-12345

# Bot bog'lanishi kerak bo'lgan Backend REST API bazaviy manzili
BACKEND_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 6. Eslatmalar Mexanizmi (Reminders)
# ------------------------------------------------------------------------------
# Tadbir boshlanishiga qancha soat qolganda eslatma yuborilishi
REMINDER_HOURS_BEFORE=24
